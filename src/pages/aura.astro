---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout 
  title="Aura AI — Next-Gen SaaS Showcase" 
  description="Futuristic SaaS landing page featuring animated glassmorphism, responsive dashboard mockups, and pure-CSS pricing toggles."
  theme="dark"
>
  <div class="relative min-h-screen flex flex-col justify-between bg-[#07090e] text-slate-100 overflow-hidden font-display selection:bg-cyan-500 selection:text-slate-950">
    
    <!-- Ambient blurred background elements -->
    <div class="absolute top-[-10%] left-[-10%] w-[500px] h-[500px] rounded-full bg-violet-600/10 blur-[150px] pointer-events-none animate-float-orb-1"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[500px] h-[500px] rounded-full bg-cyan-600/10 blur-[150px] pointer-events-none animate-float-orb-2"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-indigo-500/5 blur-[180px] pointer-events-none"></div>

    <!-- Navbar -->
    <header class="border-b border-slate-900/60 backdrop-blur-md sticky top-0 z-50 bg-[#07090e]/75">
      <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <a href={base} class="w-8 h-8 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-400 hover:text-white hover:border-slate-700 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </a>
          <span class="font-bold tracking-tight text-lg text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-cyan-400">AURA_AI</span>
        </div>
        <nav class="hidden md:flex items-center gap-8 text-sm text-slate-400 font-medium">
          <a href="#features" class="hover:text-violet-400 transition-colors">Features</a>
          <a href="#pipeline" class="hover:text-violet-400 transition-colors">Flow Pipeline</a>
          <a href="#pricing" class="hover:text-violet-400 transition-colors">Pricing</a>
          <a href="#signup" class="px-4 py-2 rounded-lg bg-gradient-to-r from-violet-500 to-cyan-500 text-slate-950 font-bold hover:shadow-[0_0_20px_rgba(168,85,247,0.4)] transition-all duration-300">Launch Terminal</a>
        </nav>
      </div>
    </header>

    <!-- Hero with CSS Dashboard Mockup -->
    <section class="max-w-7xl mx-auto px-6 py-20 w-full relative z-10">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-semibold tracking-wider text-violet-400 uppercase bg-violet-950/40 border border-violet-800/30 px-3.5 py-1.5 rounded-full mb-6 inline-block">
          Autonomous Neural Workflows
        </span>
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6 leading-tight text-white uppercase">
          Agentic intelligence <br />
          <span class="bg-gradient-to-r from-violet-400 via-indigo-300 to-cyan-400 bg-clip-text text-transparent">orchestrating your stack.</span>
        </h1>
        <p class="text-slate-400 text-base md:text-lg font-light leading-relaxed mb-8">
          Aura coordinates data ingestion, neural processing, and deployment hooks in real-time. Boost operations with zero runtime JS latency overhead.
        </p>
        <div class="flex justify-center gap-4">
          <a href="#pricing" class="px-6 py-3 rounded-lg bg-white text-slate-950 font-bold hover:bg-slate-200 transition-colors">
            View Pricing
          </a>
          <a href="#pipeline" class="px-6 py-3 rounded-lg border border-slate-800 hover:border-slate-700 text-white font-medium transition-colors">
            See Pipeline
          </a>
        </div>
      </div>

      <!-- Dashboard mockup constructed completely in CSS/Tailwind -->
      <div class="w-full max-w-5xl mx-auto glass-panel p-3 rounded-2xl shadow-[0_0_50px_rgba(0,0,0,0.5)]">
        <div class="bg-slate-950/80 rounded-xl overflow-hidden border border-slate-900">
          <!-- Window bar -->
          <div class="h-10 border-b border-slate-900 bg-slate-950 px-4 flex items-center justify-between">
            <div class="flex gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
            </div>
            <span class="text-[10px] font-mono text-slate-600 tracking-wider">AURA_WORKSPACE_v2.01</span>
            <div class="w-12"></div>
          </div>
          
          <!-- Mockup Workspace Content Grid -->
          <div class="grid grid-cols-12 md:h-[350px]">
            <!-- Sidebar -->
            <div class="col-span-3 border-r border-slate-900 p-4 space-y-4 hidden md:block">
              <div class="h-8 bg-slate-900/50 rounded border border-slate-800 flex items-center px-2 text-[10px] text-violet-400 font-mono">
                [x] neural_agents
              </div>
              <div class="space-y-2">
                <div class="h-6 w-full bg-slate-900/30 rounded"></div>
                <div class="h-6 w-4/5 bg-slate-900/30 rounded"></div>
                <div class="h-6 w-5/6 bg-slate-900/30 rounded"></div>
              </div>
            </div>
            
            <!-- Main dashboard panel -->
            <div class="col-span-12 md:col-span-9 p-6 space-y-6">
              <div class="grid grid-cols-3 gap-4">
                <div class="p-4 border border-slate-900 rounded-xl bg-slate-900/10">
                  <span class="text-[10px] text-slate-500 block uppercase">Model Latency</span>
                  <span class="text-2xl font-bold font-mono text-violet-400">12ms</span>
                </div>
                <div class="p-4 border border-slate-900 rounded-xl bg-slate-900/10">
                  <span class="text-[10px] text-slate-500 block uppercase">Context Memory</span>
                  <span class="text-2xl font-bold font-mono text-cyan-400">14.5GB</span>
                </div>
                <div class="p-4 border border-slate-900 rounded-xl bg-slate-900/10">
                  <span class="text-[10px] text-slate-500 block uppercase">API Success Rate</span>
                  <span class="text-2xl font-bold font-mono text-emerald-400">99.98%</span>
                </div>
              </div>
              
              <!-- Mini-graph built in CSS gradients -->
              <div class="h-32 border border-slate-900 bg-slate-900/10 rounded-xl p-4 flex flex-col justify-between relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-t from-violet-500/5 to-transparent"></div>
                <div class="flex justify-between items-start z-10">
                  <span class="text-xs font-semibold text-slate-400">Throughput Index</span>
                  <span class="text-[10px] font-mono text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded bg-emerald-500/5">STABLE</span>
                </div>
                <!-- CSS Wave Representation -->
                <div class="w-full h-12 flex items-end gap-1.5 mt-auto">
                  <div class="w-full bg-violet-500/20 rounded h-1/3"></div>
                  <div class="w-full bg-violet-500/30 rounded h-1/2"></div>
                  <div class="w-full bg-violet-500/40 rounded h-2/3"></div>
                  <div class="w-full bg-indigo-500/50 rounded h-2/5"></div>
                  <div class="w-full bg-cyan-500/60 rounded h-4/5 animate-pulse"></div>
                  <div class="w-full bg-cyan-500/40 rounded h-3/5"></div>
                  <div class="w-full bg-cyan-500/50 rounded h-3/4"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Node Flow (SVG node tree with CSS pulses) -->
    <section id="pipeline" class="border-t border-slate-900/60 py-24 bg-slate-950/20 relative z-10 w-full">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-16">
          <span class="text-xs font-mono text-violet-400 uppercase tracking-widest block mb-2">NEURAL ROUTING WORKFLOW</span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-white uppercase">Pipeline Architecture</h2>
        </div>

        <div class="max-w-4xl mx-auto border border-slate-900 bg-slate-950/60 p-8 rounded-2xl">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center justify-between text-center md:text-left relative">
            
            <!-- Step 1 Node -->
            <div class="relative p-6 border border-slate-800/80 rounded-xl bg-slate-950/80 hover:border-violet-500/20 transition-all">
              <span class="absolute top-3 right-3 w-3.5 h-3.5 rounded-full bg-violet-500/20 border border-violet-500/40 animate-pulse-glow flex items-center justify-center">
                <span class="w-1.5 h-1.5 rounded-full bg-violet-400"></span>
              </span>
              <h3 class="text-sm font-semibold text-slate-200 mb-2 font-mono">[01] DATA_INGESTION</h3>
              <p class="text-slate-400 text-xs font-light">
                Fetch structured logs and static payloads via Git webhooks instantly.
              </p>
            </div>
            
            <!-- Step 2 Node -->
            <div class="relative p-6 border border-slate-800/80 rounded-xl bg-slate-950/80 hover:border-indigo-500/20 transition-all">
              <span class="absolute top-3 right-3 w-3.5 h-3.5 rounded-full bg-indigo-500/20 border border-indigo-500/40 animate-pulse-glow flex items-center justify-center">
                <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
              </span>
              <h3 class="text-sm font-semibold text-slate-200 mb-2 font-mono">[02] NEURAL_TRANSFORM</h3>
              <p class="text-slate-400 text-xs font-light">
                Compile static bundles and execute styling optimizations.
              </p>
            </div>
            
            <!-- Step 3 Node -->
            <div class="relative p-6 border border-slate-800/80 rounded-xl bg-slate-950/80 hover:border-cyan-500/20 transition-all">
              <span class="absolute top-3 right-3 w-3.5 h-3.5 rounded-full bg-cyan-500/20 border border-cyan-500/40 animate-pulse-glow flex items-center justify-center">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
              </span>
              <h3 class="text-sm font-semibold text-slate-200 mb-2 font-mono">[03] EDGE_DEPLOYMENT</h3>
              <p class="text-slate-400 text-xs font-light">
                Cache generated files at global edge servers on Netlify CDN.
              </p>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- Pricing Section (Pure CSS pricing toggle) -->
    <section id="pricing" class="border-t border-slate-900/60 py-24 w-full relative z-10">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-12">
          <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest block mb-2">SCALE PRICING</span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-white uppercase mb-6">Subscription Matrix</h2>
          
          <!-- State inputs for Pricing Toggle -->
          <!-- We place this input before the pricing cards parent so we can control them easily via peers -->
          <div class="inline-flex items-center gap-3 p-1 rounded-lg border border-slate-800 bg-slate-950/80 backdrop-blur-md">
            <span class="text-xs font-semibold px-3 py-1.5 text-slate-400 select-none">Monthly Billing</span>
            
            <input type="checkbox" id="pricing-toggle" class="sr-only peer" />
            <label for="pricing-toggle" class="relative w-12 h-6 bg-slate-800 rounded-full cursor-pointer transition-all duration-300
                                                 peer-checked:bg-violet-600 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-5 after:h-5 after:bg-white after:rounded-full after:transition-all after:duration-300
                                                 peer-checked:after:translate-x-6"></label>
            
            <span class="text-xs font-semibold px-3 py-1.5 text-slate-400 select-none">Yearly Billing (Save 20%)</span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-3xl mx-auto">
          <!-- Pricing Card 1 -->
          <div class="glass-panel p-8 rounded-2xl flex flex-col justify-between border border-slate-800/80">
            <div>
              <span class="text-xs text-violet-400 uppercase font-mono block mb-2">DEVELOPER NODE</span>
              <h3 class="text-2xl font-bold text-white mb-4">Starter Calibre</h3>
              
              <!-- Prices referencing the pricing-toggle checkbox state -->
              <div class="mb-6">
                <!-- If checkbox is checked (Yearly), hide monthly price -->
                <div class="text-4xl font-extrabold font-mono text-slate-100 inline-block" id="starter-monthly">$29<span class="text-xs text-slate-500 font-sans"> / mo</span></div>
                
                <!-- If checkbox is checked (Yearly), show yearly price -->
                <div class="text-4xl font-extrabold font-mono text-slate-100 hidden" id="starter-yearly">$23<span class="text-xs text-slate-500 font-sans"> / mo</span></div>
                
                <span class="block text-[10px] text-slate-500 mt-1" id="starter-billed-monthly">Billed monthly</span>
                <span class="block text-[10px] text-slate-500 mt-1 hidden" id="starter-billed-yearly">Billed annually (Save 20%)</span>
              </div>
              
              <ul class="space-y-3 text-xs text-slate-400 mb-8 border-t border-slate-900 pt-6">
                <li class="flex items-center gap-2">✓ 1 Million Agent Tokens / mo</li>
                <li class="flex items-center gap-2">✓ Standard edge execution routing</li>
                <li class="flex items-center gap-2">✓ 3 Connected workspace pipelines</li>
                <li class="flex items-center gap-2">✓ Developer community support</li>
              </ul>
            </div>
            
            <button class="w-full py-3 rounded-lg border border-slate-800 hover:border-slate-700 text-white font-medium text-xs uppercase tracking-wider transition-all">
              Initialize Calibre
            </button>
          </div>

          <!-- Pricing Card 2 -->
          <div class="glass-panel p-8 rounded-2xl flex flex-col justify-between border-2 border-violet-500/20 relative">
            <span class="absolute top-0 right-6 -translate-y-1/2 px-3 py-1 rounded bg-violet-600 text-slate-950 text-[10px] font-bold tracking-widest uppercase">
              RECOMMENDED
            </span>
            <div>
              <span class="text-xs text-cyan-400 uppercase font-mono block mb-2">PRODUCTION NETWORK</span>
              <h3 class="text-2xl font-bold text-white mb-4">Enterprise Aura</h3>
              
              <div class="mb-6">
                <div class="text-4xl font-extrabold font-mono text-slate-100 inline-block" id="premium-monthly">$99<span class="text-xs text-slate-500 font-sans"> / mo</span></div>
                
                <div class="text-4xl font-extrabold font-mono text-slate-100 hidden" id="premium-yearly">$79<span class="text-xs text-slate-500 font-sans"> / mo</span></div>
                
                <span class="block text-[10px] text-slate-500 mt-1" id="premium-billed-monthly">Billed monthly</span>
                <span class="block text-[10px] text-slate-500 mt-1 hidden" id="premium-billed-yearly">Billed annually (Save 20%)</span>
              </div>
              
              <ul class="space-y-3 text-xs text-slate-400 mb-8 border-t border-slate-900 pt-6">
                <li class="flex items-center gap-2">✓ 50 Million Agent Tokens / mo</li>
                <li class="flex items-center gap-2">✓ Prioritized node ingestion caching</li>
                <li class="flex items-center gap-2">✓ Dedicated Vector storage (10GB)</li>
                <li class="flex items-center gap-2">✓ 24/7 SLA & Team Workspace access</li>
              </ul>
            </div>
            
            <button class="w-full py-3 rounded-lg bg-gradient-to-r from-violet-500 to-cyan-500 text-slate-950 font-bold text-xs uppercase tracking-wider hover:shadow-[0_0_20px_rgba(168,85,247,0.3)] transition-all">
              Provision Enterprise
            </button>
          </div>
        </div>

      </div>
    </section>

    <!-- Footer -->
    <footer class="w-full text-center py-12 border-t border-slate-900 text-xs text-slate-600 bg-slate-950">
      <p>© {new Date().getFullYear()} AURA_SaaS. Deployed via Git Edge.</p>
    </footer>
  </div>

  <style is:global>
    /* Dynamic billing pricing switch via CSS has() */
    body:has(#pricing-toggle:checked) #starter-monthly {
      display: none !important;
    }
    body:has(#pricing-toggle:checked) #starter-yearly {
      display: inline-block !important;
    }
    body:has(#pricing-toggle:checked) #premium-monthly {
      display: none !important;
    }
    body:has(#pricing-toggle:checked) #premium-yearly {
      display: inline-block !important;
    }
    body:has(#pricing-toggle:checked) #starter-billed-monthly {
      display: none !important;
    }
    body:has(#pricing-toggle:checked) #starter-billed-yearly {
      display: block !important;
    }
    body:has(#pricing-toggle:checked) #premium-billed-monthly {
      display: none !important;
    }
    body:has(#pricing-toggle:checked) #premium-billed-yearly {
      display: block !important;
    }
  </style>
</Layout>
